# Copy to .env and fill in real values. Without DATABASE_URL the app runs
# on JSON files under data/ instead of Postgres.
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string

# Builtin account passwords. If unset, local dev defaults are used
# (Super_Admin/Kali_5545, admin/5545, Seema/5052). SET these on any
# internet-facing deploy — the defaults are known publicly via the repo.
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
# Seema (managed owner account, username 9818100062)
SEEMA_PASSWORD=

# eSewa EPay. Sandbox mode uses eSewa's public test merchant (no real money).
# For live payments, register as an eSewa merchant and set:
#   ESEWA_MODE=live
#   ESEWA_SCD=<your merchant code>
#   ESEWA_SECRET=<your merchant key>
ESEWA_MODE=sandbox
ESEWA_SCD=EPAYTEST
ESEWA_SECRET=8gBm/:&EnhH.1/q

# Push notifications.
#   Web/browser (VAPID): set a stable pair so subscriptions survive redeploys.
#   VAPID_PUBLIC_KEY=<generated>
#   VAPID_PRIVATE_KEY=<generated>
#   (omit both and the server generates + persists a pair to data/vapid.json)
#
#   Android FCM: a Firebase service account (JSON). Either inline (FCM_ACCOUNT)
#   or path to a JSON file (FCM_ACCOUNT_FILE). Android pushes are skipped until
#   this is set.
#   FCM_ACCOUNT={"type":"service_account",...}
#   FCM_ACCOUNT_FILE=data/firebase-service-account.json